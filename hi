-- ═══════════════════════════════════════════════════
-- COMBINED SCRIPT
-- Sections: 1) Lighting  2) Baseplate  3) TVM Reanimation GUI  4) Voice Mute Badges  5) Gameplay window (resizable) with a Reanim popup button
-- Each section runs in its own thread inside pcall, so a failure or a
-- long wait in one (e.g. the voice section waiting for you to unmute)
-- never blocks or breaks the others.
-- ═══════════════════════════════════════════════════

local function run(name, fn)
    task.spawn(function()
        local ok, err = pcall(fn)
        if not ok then
            warn("[Combined] " .. name .. " failed: " .. tostring(err))
        end
    end)
end

-- Drag-to-resize grip (bottom-right corner) shared by both windows
local function makeResizable(frame, minW, minH, maxW, maxH)
    local UIS = game:GetService("UserInputService")
    local pink = Color3.fromRGB(255, 105, 185)

    local grip = Instance.new("TextButton")
    grip.Name = "ResizeGrip"
    grip.Size = UDim2.new(0, 20, 0, 20)
    grip.Position = UDim2.new(1, -20, 1, -20)
    grip.BackgroundTransparency = 1
    grip.Text = ""
    grip.AutoButtonColor = false
    grip.ZIndex = 100
    grip.Parent = frame

    for _, ln in ipairs({ { 11, 16 }, { 14, 8 } }) do
        local l = Instance.new("Frame")
        l.AnchorPoint = Vector2.new(0.5, 0.5)
        l.Position = UDim2.fromOffset(ln[1], ln[1])
        l.Size = UDim2.fromOffset(ln[2], 2)
        l.Rotation = -45
        l.BackgroundColor3 = pink
        l.BorderSizePixel = 0
        l.Active = false
        l.ZIndex = 101
        l.Parent = grip
    end

    grip.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local startMouse = input.Position
        local startW, startH = frame.AbsoluteSize.X, frame.AbsoluteSize.Y
        local moveConn, endConn
        moveConn = UIS.InputChanged:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
                local d = i.Position - startMouse
                frame.Size = UDim2.new(0, math.clamp(startW + d.X, minW, maxW), 0, math.clamp(startH + d.Y, minH, maxH))
            end
        end)
        endConn = UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                moveConn:Disconnect()
                endConn:Disconnect()
            end
        end)
    end)
    return grip
end

-- ═══════════════ HUB (Gameplay window + Reanim popup button) ═══════════════
local Hub = { pages = {}, cleanups = {} }
do
    local CoreGui = game:GetService("CoreGui")
    local UIS = game:GetService("UserInputService")

    if _G.__HubCleanup then pcall(_G.__HubCleanup) end
    local oldHub = CoreGui:FindFirstChild("HubPanel")
    if oldHub then oldHub:Destroy() end

    local PURPLE = Color3.fromRGB(139, 61, 255)
    local PINK   = Color3.fromRGB(255, 64, 170)
    local RED    = Color3.fromRGB(255, 59, 92)

    local hubConns = {}
    local function bind(sig, fn)
        table.insert(hubConns, sig:Connect(fn))
    end

    local function corner(p, r)
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, r)
        c.Parent = p
        return c
    end
    local function grad(p, rot, seq)
        local g = Instance.new("UIGradient")
        g.Color = seq or ColorSequence.new({
            ColorSequenceKeypoint.new(0, PURPLE),
            ColorSequenceKeypoint.new(0.5, PINK),
            ColorSequenceKeypoint.new(1, RED),
        })
        g.Rotation = rot or 0
        g.Parent = p
        return g
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "HubPanel"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.Parent = CoreGui
    Hub.gui = gui

    local W, H = 600, 680
    local main = Instance.new("Frame")
    main.Size = UDim2.new(0, W, 0, H)
    main.Position = UDim2.new(0.5, -W / 2, 0.5, -H / 2)
    main.BackgroundColor3 = Color3.new(1, 1, 1)
    main.BorderSizePixel = 0
    main.Parent = gui
    corner(main, 12)
    grad(main, 90, ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 9, 36)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(28, 10, 44)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(40, 10, 40)),
    }))
    local mainStroke = Instance.new("UIStroke")
    mainStroke.Color = Color3.new(1, 1, 1)
    mainStroke.Thickness = 2
    mainStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    mainStroke.Parent = main
    grad(mainStroke, 45)

    makeResizable(main, 460, 420, 1000, 1100)

    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 40)
    titleBar.BackgroundTransparency = 1
    titleBar.Parent = main

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(0, 200, 1, 0)
    titleLbl.Position = UDim2.new(0, 14, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = "GAMEPLAY"
    titleLbl.TextColor3 = Color3.new(1, 1, 1)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 16
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.Parent = titleBar
    grad(titleLbl, 0)

    local titleLine = Instance.new("Frame")
    titleLine.Size = UDim2.new(1, -24, 0, 2)
    titleLine.Position = UDim2.new(0, 12, 1, -2)
    titleLine.BackgroundColor3 = Color3.new(1, 1, 1)
    titleLine.BorderSizePixel = 0
    titleLine.Parent = titleBar
    grad(titleLine, 0)

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 24, 0, 24)
    closeBtn.Position = UDim2.new(1, -36, 0.5, -12)
    closeBtn.BackgroundColor3 = RED
    closeBtn.Text = "x"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 12
    closeBtn.AutoButtonColor = false
    closeBtn.Parent = titleBar
    corner(closeBtn, 12)

    -- Reanim popup button
    local reBtn = Instance.new("TextButton")
    reBtn.Size = UDim2.new(0, 100, 0, 26)
    reBtn.Position = UDim2.new(1, -148, 0.5, -13)
    reBtn.BackgroundTransparency = 1
    reBtn.Text = ""
    reBtn.AutoButtonColor = false
    reBtn.Parent = titleBar
    corner(reBtn, 13)

    local reFill = Instance.new("Frame")
    reFill.Size = UDim2.new(1, 0, 1, 0)
    reFill.BackgroundColor3 = Color3.new(1, 1, 1)
    reFill.BorderSizePixel = 0
    reFill.Active = false
    reFill.Parent = reBtn
    corner(reFill, 13)
    grad(reFill, 0)

    local reLbl = Instance.new("TextLabel")
    reLbl.Size = UDim2.new(1, 0, 1, 0)
    reLbl.BackgroundTransparency = 1
    reLbl.Text = "Reanim"
    reLbl.TextColor3 = Color3.new(1, 1, 1)
    reLbl.Font = Enum.Font.GothamBold
    reLbl.TextSize = 12
    reLbl.ZIndex = 2
    reLbl.Active = false
    reLbl.Parent = reBtn

    reBtn.MouseButton1Click:Connect(function()
        local g = Hub.reanimGui
        if g and g.Parent then
            g.Enabled = not g.Enabled
        else
            reLbl.Text = "Loading..."
            task.delay(1.5, function()
                if reLbl.Parent then reLbl.Text = "Reanim" end
            end)
        end
    end)

    -- Drag the window by its title bar
    local dragging, dragStart, startPos = false, nil, nil
    bind(titleBar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
        end
    end)
    bind(UIS.InputChanged, function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    bind(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    bind(UIS.InputBegan, function(input)
        if input.KeyCode == Enum.KeyCode.RightShift and not UIS:GetFocusedTextBox() then
            main.Visible = not main.Visible
        end
    end)

    -- Page the Gameplay section builds into
    local page = Instance.new("Frame")
    page.Name = "GameplayPage"
    page.Size = UDim2.new(1, -16, 1, -52)
    page.Position = UDim2.new(0, 8, 0, 46)
    page.BackgroundTransparency = 1
    page.ClipsDescendants = true
    page.Parent = main
    Hub.pages.Gameplay = page

    local function closeAll()
        for _, fn in ipairs(Hub.cleanups) do pcall(fn) end
        for _, c in ipairs(hubConns) do pcall(function() c:Disconnect() end) end
        hubConns = {}
        gui:Destroy()
        _G.__HubCleanup = nil
    end
    _G.__HubCleanup = closeAll
    closeBtn.MouseButton1Click:Connect(closeAll)
end

